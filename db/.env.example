# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, enter the same names under Project Settings > Environment Variables.

# SQL Server (use the limited pos_app login, not sa)
DB_SERVER=localhost
# Use DB_PORT (a fixed TCP port, 1433 by default) or DB_INSTANCE (named instance, e.g. SQLEXPRESS), not both.
DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS
DB_DATABASE=pos_store
DB_USER=pos_app
DB_PASSWORD=
# Hosted servers: encrypt=true. Local SQL Server Express with a self-signed
# certificate: set DB_TRUST_SERVER_CERT=true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
# Optional. A hosted database that sleeps when idle (Azure SQL free tier) needs a moment to wake up.
# DB_CONNECT_TIMEOUT_MS=30000   # how long one connection attempt may take
# DB_RETRY_SECONDS=40           # keep retrying this long while it wakes; 0 = no retry

# Signs the login cookie. At least 32 characters, random, different per environment.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Protects /api/jobs/notifications. Vercel Cron sends it as a Bearer token. Random, 16+ characters.
CRON_SECRET=
